# Copy to .env.local for local development. In Vercel, add the same names under
# Project Settings > Environment Variables.

# --- Required -----------------------------------------------------------------

# Supabase: Project Settings > API Keys. Locally, `npx supabase status` prints them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# The only account allowed into /admin. Create this user in Supabase Auth.
ADMIN_EMAIL=you@example.com

# Domain the app runs on. Live sites are served at <slug>.ROOT_DOMAIN.
# Local development: localhost:3000 (sites open at http://<slug>.localhost:3000)
ROOT_DOMAIN=localhost:3000

# Shown on checkout as "Contact us to activate" while billing is the stub
# provider in production.
SALES_PHONE=(555) 010-0199

# Shared secret for the queue worker route (POST /api/worker). Supabase pg_cron
# sends it as "Authorization: Bearer <secret>". Generate one with:
#   openssl rand -hex 32
WORKER_SECRET=

# --- Optional: without these the app uses built-in fixture responses ------------

# Claude writes the site copy. APP_ANTHROPIC_API_KEY is read first, then
# ANTHROPIC_API_KEY. Without either, deterministic sample copy is used.
APP_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Google Places API (New): name, address, phone, hours, category, website.
# Without a key, fixture businesses are used.
GOOGLE_PLACES_API_KEY=
